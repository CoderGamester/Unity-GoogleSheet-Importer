.importer-window {
    padding: 6px;
}

.importer-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.importer-toolbar__summary {
    flex-grow: 1;
    -unity-text-align: middle-right;
    opacity: 0.7;
}

.importer-key {
    flex-direction: row;
    align-items: center;
}

.importer-key__field {
    flex-grow: 1;
    flex-shrink: 1;
}

.importer-key__status {
    margin: 0 4px 4px 4px;
    opacity: 0.7;
    white-space: normal;
}

.importer-row {
    padding: 6px 2px;
    border-bottom-width: 1px;
    border-color: rgba(128, 128, 128, 0.3);
}

.importer-row__header {
    flex-direction: row;
    align-items: center;
}

.importer-row__labels {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.importer-row__title {
    flex-direction: row;
    align-items: center;
}

.importer-row__name {
    -unity-font-style: bold;
}

.importer-badge {
    margin-left: 6px;
    padding: 0 4px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(128, 128, 128, 0.6);
    font-size: 10px;
}

.importer-row__status {
    margin-top: 2px;
    opacity: 0.7;
}

.importer-row__path {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: start;
    opacity: 0.85;
}
